{
  "name": "tester-army-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes TesterArmy's UI testing capabilities (generate workflows, run them in Browserbase, get structured failure reports) to coding agents like Claude Code, Cursor, and Windsurf.",
  "type": "module",
  "bin": {
    "tester-army-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@browserbasehq/sdk": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ai": "^6.0.162",
    "playwright-core": "^1.59.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
